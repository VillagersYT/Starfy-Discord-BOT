# Token du bot (Portail développeur Discord > Bot)
DISCORD_TOKEN=
# Application ID (Portail développeur Discord > General Information)
DISCORD_CLIENT_ID=
# Clé API Hypixel (https://developer.hypixel.net/dashboard)
HYPIXEL_API_KEY=
# IDs Discord des admins du bot, séparés par des virgules
BOT_ADMIN_IDS=
# (Optionnel) ID d'une guilde de test pour déployer les commandes instantanément
DEV_GUILD_ID=
# (Optionnel) chemin de la base SQLite
DATABASE_PATH=./data/starfy.db
